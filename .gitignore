.venv/
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/

# Cached datasets, re-downloaded on first run
data/*.csv
data/*.xlsx

# Trained model binaries, regenerated by the pipeline
models/*.joblib

# Reduced-scale prediction dumps; the full-scale ones are kept so the
# McNemar tests can be reproduced from a clone
results/predictions/*.npz
!results/predictions/*__full.npz

.pytest_cache/
*.log
.vscode/
.idea/
